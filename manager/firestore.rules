rules_version = '2';

// Accesso solo dopo il login con l'account condiviso della band
// (Firebase Authentication, email + password: la password la conosce solo la band).
// Le funzioni del server (promemoria, notifiche) usano l'account di servizio e
// non passano da queste regole.
service cloud.firestore {
  match /databases/{database}/documents {
    function band() { return request.auth != null; }
    match /leads/{id}    { allow read, write: if band(); }
    match /attivita/{id} { allow read, write: if band(); }
    match /spese/{id}    { allow read, write: if band(); }
    match /config/{id}   { allow read, write: if band(); }
    match /scalette/{id} { allow read, write: if band(); }
    match /date/{id}     { allow read, write: if band(); }
    match /{document=**} { allow read, write: if false; }
  }
}
