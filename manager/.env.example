# Chiavi del progetto Firebase (Console Firebase → Impostazioni progetto → Le tue app → App web → Config).
# Copia questo file in ".env" e incolla i valori. NON committare il file .env.
# Le stesse 6 variabili vanno aggiunte anche nelle "Environment Variables" di Vercel/Netlify.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo per sviluppo locale con l'emulatore Firestore (lasciare vuoto/commentato in produzione):
# VITE_FIRESTORE_EMULATOR=localhost:8080

# --- Notifiche push (promemoria delle 9:00) ---
# Firebase → ⚙️ Impostazioni progetto → Cloud Messaging → Certificati push web → Genera coppia di chiavi
VITE_FIREBASE_VAPID_KEY=
# Solo su Vercel (lato server, NON serve nel .env locale):
# FIREBASE_SERVICE_ACCOUNT = contenuto intero del file JSON scaricato da
#   Firebase → ⚙️ Impostazioni progetto → Account di servizio → Genera nuova chiave privata
# CRON_SECRET = una password lunga a piacere (protegge l'endpoint /api/promemoria)

# --- Ricerca locali con AI (solo su Vercel, lato server) ---
# ANTHROPIC_API_KEY = chiave API da https://console.anthropic.com (API Keys)
# RICERCHE_MAX_GIORNO = limite di ricerche al giorno (facoltativo, default 10)
