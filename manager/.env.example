# Chiavi del progetto Firebase (Console Firebase → Impostazioni progetto → Le tue app → App web → Config).
# Copia questo file in ".env" e incolla i valori. NON committare il file .env.
# Le stesse 6 variabili vanno aggiunte anche nelle "Environment Variables" di Vercel/Netlify.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo per sviluppo locale con l'emulatore Firestore (lasciare vuoto/commentato in produzione):
# VITE_FIRESTORE_EMULATOR=localhost:8080
